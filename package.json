{
  "name": "cinestack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A movie theatre platform: showtimes, seats, snacks and tickets, run by the theatre's own manager. Built with Zubra on one small Node server.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node bin/seed.js",
    "demo": "node bin/seed.js --fresh && node server.js",
    "test": "node --test test/*.test.js",
    "design-check": "node scripts/design-check.js"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@journey-to-code/symbology": "0.2.0",
    "@potomac-solutions/kit": "github:Potomac-Solutions/potomac-kit#a4901ea3b31165c2cd5f5e9a35e9876332020ab9",
    "@zubra/actions": "^6.0.5",
    "@zubra/compiler": "^6.0.5",
    "@zubra/runtime": "^6.0.5",
    "@zubra/server": "^6.0.5",
    "@zubra/sync": "^6.0.5"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": "26.x"
  }
}
